+#[cfg(target_os = "macos")]
+#[test]
+#[ignore = "native process-group distinction gate; run explicitly on macOS"]
+fn ordinary_broker_child_keeps_its_own_group() {
+    let temp = tempfile::tempdir().expect("tempdir");
+    let mut owner = live_tree_owner();
+    let mut ordinary = ExecutionBroker::new()
+        .spawn(&spec(temp.path(), "/bin/sleep", &["5"]))
+        .expect("ordinary broker spawn");
+    let ordinary_pid = ordinary.id() as libc::pid_t;
+    let owner_pid = owner.id() as libc::pid_t;
+    assert_eq!(unsafe { libc::getpgid(ordinary_pid) }, ordinary_pid);
+    assert_ne!(unsafe { libc::getpgid(ordinary_pid) }, owner_pid);
+    ordinary
+        .terminate_tree()
+        .expect("terminate ordinary child tree");
+    assert!(ordinary
+        .wait_tree_exit(std::time::Duration::from_secs(2))
+        .unwrap());
+    owner.terminate_tree().expect("terminate fixture owner");
+    assert!(owner
+        .wait_tree_exit(std::time::Duration::from_secs(2))
+        .unwrap());
+}
