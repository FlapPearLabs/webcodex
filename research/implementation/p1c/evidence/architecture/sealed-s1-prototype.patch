+#[cfg(target_os = "macos")]
+#[test]
+fn environment_fixture_entrypoint() {
+    if std::env::var_os("WEBCODEX_TEST_ENV_HELPER").is_none() {
+        return;
+    }
+
+    const HOST_SECRET: &str = "WEBCODEX_TEST_HOST_SECRET";
+    const FAKE_HOME: &str = "WEBCODEX_TEST_FAKE_HOME";
+    const PROJECT_ROOT: &str = "WEBCODEX_TEST_PROJECT_ROOT";
+    let host_secret = std::env::var(HOST_SECRET).expect("synthetic host secret fixture");
+    let fake_home = std::env::var(FAKE_HOME).expect("fake host HOME fixture");
+    assert_eq!(host_secret, "SYNTHETIC_HOST_SECRET_SENTINEL_96f2");
+    assert_eq!(std::env::var("HOME").expect("fixture HOME"), fake_home);
+    let project_root = std::path::PathBuf::from(
+        std::env::var_os(PROJECT_ROOT).expect("authorized project root fixture"),
+    );
+
+    let mut owner = live_tree_owner();
+    let script = "printf 'HOST_SECRET=%s\\nEXPLICIT=%s\\nHOME=%s\\n' \"${WEBCODEX_TEST_HOST_SECRET-ABSENT}\" \"${WEBCODEX_ALLOWED_TEST_VALUE-ABSENT}\" \"${HOME-ABSENT}\"";
+    let request = SpawnSpec::new(
+        "/bin/sh",
+        &project_root,
+        SandboxPlan::read_write_in(&[project_root.clone()]),
+    )
+    .args(["-c", script])
+    .env_var("WEBCODEX_ALLOWED_TEST_VALUE", "explicit-ok")
+    .stdout(StreamPolicy::Piped)
+    .stderr(StreamPolicy::Piped);
+    let mut payload = ExecutionBroker::new()
+        .spawn_in_supervised_unix_tree(&request, &[], &mut owner)
+        .expect("spawn minimal-environment probe");
+    let stdout = payload.stdout.take().expect("probe stdout pipe");
+    let stderr = payload.stderr.take().expect("probe stderr pipe");
+    let out_reader = std::thread::spawn(move || {
+        let mut bytes = Vec::new();
+        stdout.take(4096).read_to_end(&mut bytes).map(|_| bytes)
+    });
+    let err_reader = std::thread::spawn(move || {
+        let mut bytes = Vec::new();
+        stderr.take(4096).read_to_end(&mut bytes).map(|_| bytes)
+    });
+    let deadline = std::time::Instant::now() + std::time::Duration::from_secs(8);
+    let status = loop {
+        if let Some(status) = payload.try_wait().expect("poll env probe") {
+            break status;
+        }
+        if std::time::Instant::now() >= deadline {
+            owner
+                .terminate_tree()
+                .expect("terminate timed out env probe group");
+            panic!("environment probe exceeded 8 second deadline");
+        }
+        std::thread::sleep(std::time::Duration::from_millis(10));
+    };
+    let output = String::from_utf8_lossy(
+        &out_reader
+            .join()
+            .expect("probe stdout reader")
+            .expect("read probe stdout"),
+    )
+    .into_owned();
+    let error = String::from_utf8_lossy(
+        &err_reader
+            .join()
+            .expect("probe stderr reader")
+            .expect("read probe stderr"),
+    )
+    .into_owned();
+    assert!(
+        status.success(),
+        "minimal-environment probe failed: stdout={output:?}, stderr={error:?}"
+    );
+    assert!(output.contains("HOST_SECRET=ABSENT"), "{output:?}");
+    assert!(output.contains("EXPLICIT=explicit-ok"), "{output:?}");
+    assert!(
+        output.contains(&format!("HOME={}\n", project_root.display())),
+        "HOME did not use authorized project cwd: {output:?}"
+    );
+    assert!(
+        !output.contains(&fake_home),
+        "fake fixture HOME leaked into payload: {output:?}"
+    );
+    println!("WEBCODEX_ENV_FIXTURE=PASS");
+    owner.terminate_tree().expect("terminate env probe owner");
+    assert!(owner
+        .wait_tree_exit(std::time::Duration::from_secs(2))
+        .unwrap());
+}
