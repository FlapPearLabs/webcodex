+#[cfg(target_os = "macos")]
+#[test]
+#[ignore = "native watchdog EOF/process-tree cleanup gate; run explicitly on macOS"]
+fn supervisor_watchdog_eof_kills_payload_group() {
+    use std::time::{Duration, Instant};
+
+    // This test binary acts as the supervisor fixture. Its stdin pipe is the
+    // watchdog lifetime channel; the test process drops the sole writer below.
+    let executable = std::env::current_exe().expect("current test executable");
+    let mut command = Command::new(executable);
+    command
+        .arg("--exact")
+        .arg("execution_broker::supervised_tree_tests::watchdog_subprocess_entrypoint")
+        .arg("--nocapture")
+        .env("WEBCODEX_TEST_WATCHDOG_HELPER", "1")
+        .stdin(Stdio::piped())
+        .stdout(Stdio::null())
+        .stderr(Stdio::null());
+    let mut owner = ManagedChild::spawn(&mut command).expect("spawn watchdog fixture");
+    let writer = owner
+        .child_mut()
+        .stdin
+        .take()
+        .expect("watchdog pipe writer");
+    let temp = tempfile::tempdir().expect("tempdir");
+    let marker = temp.path().join("payload-started");
+    let request = spec(
+        temp.path(),
+        "/bin/sh",
+        &[
+            "-c",
+            &format!("touch '{}'; exec /bin/sleep 60", marker.display()),
+        ],
+    );
+    let mut payload = ExecutionBroker::new()
+        .spawn_in_supervised_unix_tree(&request, &[], &mut owner)
+        .expect("spawn payload in watchdog group");
+    let deadline = Instant::now() + Duration::from_secs(3);
+    while !marker.exists() && Instant::now() < deadline {
+        std::thread::sleep(Duration::from_millis(10));
+    }
+    assert!(
+        marker.exists(),
+        "payload did not start before watchdog close"
+    );
+    drop(writer);
+    while payload.try_wait().expect("poll payload exit").is_none()
+        && Instant::now() < deadline + Duration::from_secs(3)
+    {
+        std::thread::sleep(Duration::from_millis(10));
+    }
+    assert!(
+        payload.try_wait().expect("final payload poll").is_some(),
+        "watchdog EOF must kill payload"
+    );
+    assert!(owner
+        .wait_tree_exit(Duration::from_secs(2))
+        .expect("wait group exit"));
+}
