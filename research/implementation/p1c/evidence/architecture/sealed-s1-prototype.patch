+            network: NetworkPolicy::Allow,
+        },
+    )
+    .arg(marker.to_str().unwrap());
+    assert!(matches!(
+        broker.spawn_in_supervised_unix_tree(&uncompileable, &[], &mut owner),
+        Err(BrokerError::PlanNotCompilable(_))
+    ));
+
+    assert!(
+        !marker.exists(),
+        "pre-start refusals must not launch payload"
+    );
+    owner.terminate_tree().expect("terminate fixture owner");
+    assert!(owner
+        .wait_tree_exit(std::time::Duration::from_secs(2))
+        .unwrap());
+}
