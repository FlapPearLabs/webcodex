+    /// Spawn a sandboxed payload into the live Unix process group owned by
+    /// `tree_owner`. The returned child is waited by its caller; the existing
+    /// tree owner remains responsible for descendant cleanup.
+    ///
+    /// This is deliberately not `ManagedChild::spawn`: that method starts a
+    /// new private process group, which would detach this payload from the
+    /// supervisor's watchdog group.
+    pub fn spawn_in_supervised_unix_tree(
+        &self,
+        spec: &SpawnSpec,
+        toolchain_roots: &[TrustedToolchainRoot],
+        tree_owner: &mut ManagedChild,
+    ) -> Result<Child, BrokerError> {
+        #[cfg(target_os = "macos")]
+        {
+            use std::os::unix::process::CommandExt;
+
+            if matches!(&spec.env, EnvPolicy::Inherit) {
+                return Err(BrokerError::SpecInvalid(
+                    "supervised payload cannot inherit the supervisor environment",
+                ));
+            }
+            if [spec.stdin, spec.stdout, spec.stderr]
+                .into_iter()
+                .any(|stream| stream == StreamPolicy::Inherit)
+            {
+                return Err(BrokerError::SpecInvalid(
+                    "supervised payload cannot inherit supervisor standard streams",
+                ));
+            }
+
+            let mut command = self.build_command_with_toolchain(spec, toolchain_roots)?;
+            if tree_owner
+                .try_wait()
+                .map_err(BrokerError::Launch)?
+                .is_some()
+            {
+                return Err(BrokerError::SpecInvalid(
+                    "supervised process-tree owner has already exited",
+                ));
+            }
+
+            let owner_pid = libc::pid_t::try_from(tree_owner.id())
+                .map_err(|_| BrokerError::SpecInvalid("invalid process-tree owner pid"))?;
+            // SAFETY: owner_pid is obtained from this borrowed ManagedChild;
+            // getsid(0) queries the current supervisor process.
+            let owner_group = unsafe { libc::getpgid(owner_pid) };
+            let owner_session = unsafe { libc::getsid(owner_pid) };
+            let current_session = unsafe { libc::getsid(0) };
+            if owner_group != owner_pid || owner_session < 0 || current_session < 0 {
+                return Err(BrokerError::SpecInvalid(
+                    "supervised process-tree owner is not a live private process-group leader",
+                ));
+            }
+            if owner_session != current_session {
+                return Err(BrokerError::SpecInvalid(
+                    "supervised process-tree owner is outside the supervisor session",
+                ));
+            }
+
+            command.process_group(owner_pid);
+            command.spawn().map_err(BrokerError::Launch)
+        }
+
+        #[cfg(not(target_os = "macos"))]
+        {
+            let _ = (spec, toolchain_roots, tree_owner);
+            Err(BrokerError::UnsupportedPlatform)
+        }
+    }
