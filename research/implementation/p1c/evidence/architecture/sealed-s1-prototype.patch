+// SPDX-License-Identifier: Apache-2.0
+//! Tests for the narrow supervisor-owned Unix process-group spawn primitive.
+
+use std::io::Read;
+use std::process::{Command, Stdio};
+
+use super::{
+    BrokerError, EnvPolicy, ExecutionBroker, NetworkPolicy, SandboxPlan, SpawnSpec, StreamPolicy,
+};
+use crate::ManagedChild;
+
+#[cfg(target_os = "macos")]
+fn spec(root: &std::path::Path, program: &str, args: &[&str]) -> SpawnSpec {
+    SpawnSpec::new(
+        program,
+        root,
+        SandboxPlan::read_write_in(&[root.to_path_buf()]),
+    )
+    .args(args.iter().copied())
+}
+
+#[cfg(target_os = "macos")]
+fn live_tree_owner() -> ManagedChild {
+    let mut command = Command::new("/bin/sleep");
+    command
+        .arg("60")
+        .stdin(Stdio::null())
+        .stdout(Stdio::null())
+        .stderr(Stdio::null());
+    ManagedChild::spawn(&mut command).expect("spawn owned tree fixture")
+}
+
+#[cfg(target_os = "macos")]
+#[test]
+fn supervised_spawn_rejects_inherited_environment_and_streams_before_spawn() {
+    let temp = tempfile::tempdir().expect("tempdir");
+    let marker = temp.path().join("must-not-exist");
+    let broker = ExecutionBroker::new();
+    let mut owner = live_tree_owner();
+
+    let inherited_env =
+        spec(temp.path(), "/usr/bin/touch", &[marker.to_str().unwrap()]).env(EnvPolicy::Inherit);
+    assert!(matches!(
+        broker.spawn_in_supervised_unix_tree(&inherited_env, &[], &mut owner),
+        Err(BrokerError::SpecInvalid(_))
+    ));
+
+    for (stdin, stdout, stderr) in [
+        (
+            StreamPolicy::Inherit,
+            StreamPolicy::Null,
+            StreamPolicy::Null,
+        ),
+        (
+            StreamPolicy::Null,
+            StreamPolicy::Inherit,
+            StreamPolicy::Null,
+        ),
+        (
+            StreamPolicy::Null,
+            StreamPolicy::Null,
+            StreamPolicy::Inherit,
+        ),
+    ] {
+        let mut inherited_stream = spec(temp.path(), "/usr/bin/touch", &[marker.to_str().unwrap()]);
+        inherited_stream.stdin = stdin;
+        inherited_stream.stdout = stdout;
+        inherited_stream.stderr = stderr;
+        assert!(matches!(
+            broker.spawn_in_supervised_unix_tree(&inherited_stream, &[], &mut owner),
+            Err(BrokerError::SpecInvalid(_))
+        ));
+    }
+
+    assert!(
+        !marker.exists(),
+        "refused specs must not launch their payload"
+    );
+    owner.terminate_tree().expect("terminate fixture owner");
+    owner
+        .wait_tree_exit(std::time::Duration::from_secs(2))
+        .unwrap();
+}
