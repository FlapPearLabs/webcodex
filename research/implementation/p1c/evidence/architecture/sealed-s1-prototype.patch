+#[cfg(target_os = "macos")]
+#[test]
+fn watchdog_subprocess_entrypoint() {
+    if std::env::var_os("WEBCODEX_TEST_WATCHDOG_HELPER").is_none() {
+        return;
+    }
+    let mut byte = [0u8; 1];
+    let _ = std::io::stdin().read(&mut byte);
+    // SAFETY: this test-only helper is the process-group leader whose group
+    // the parent test created; kill(0) targets only its own group.
+    unsafe { libc::kill(0, libc::SIGKILL) };
+}
+
+#[cfg(all(unix, not(target_os = "macos")))]
+#[test]
+fn supervised_spawn_refuses_without_a_macos_sandbox_backend() {
+    let mut command = Command::new("/bin/sleep");
+    command
+        .arg("60")
+        .stdin(Stdio::null())
+        .stdout(Stdio::null())
+        .stderr(Stdio::null());
+    let mut owner = ManagedChild::spawn(&mut command).expect("spawn fixture owner");
+    let spec = SpawnSpec::new(
+        "/bin/true",
+        std::env::temp_dir(),
+        SandboxPlan::read_write_in(&[std::env::temp_dir()]),
+    );
+    assert!(matches!(
+        ExecutionBroker::new().spawn_in_supervised_unix_tree(&spec, &[], &mut owner),
+        Err(BrokerError::UnsupportedPlatform)
+    ));
+    owner.terminate_tree().expect("terminate fixture owner");
+    owner
+        .wait_tree_exit(std::time::Duration::from_secs(2))
+        .unwrap();
+}
