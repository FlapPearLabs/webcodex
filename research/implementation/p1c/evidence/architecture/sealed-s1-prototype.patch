+#[cfg(target_os = "macos")]
+#[test]
+#[ignore = "native Seatbelt enforcement gate; run explicitly on macOS"]
+fn supervised_payload_is_confined_and_network_denied() {
+    use super::NetworkPolicy;
+    use std::net::TcpListener;
+    use std::path::Path;
+
+    const SYSTEM_NC: &str = "/usr/bin/nc";
+    assert!(
+        Path::new(SYSTEM_NC).is_file(),
+        "HOST_UNAVAILABLE: missing nc"
+    );
+    let temp = tempfile::tempdir().expect("tempdir");
+    let root = temp.path().join("authority");
+    let outside = temp.path().join("outside");
+    std::fs::create_dir_all(&root).expect("create authority root");
+    std::fs::create_dir_all(&outside).expect("create outside root");
+    let secret = outside.join("parent-secret");
+    std::fs::write(&secret, "PARENT_SECRET_7db1\n").expect("write secret fixture");
+
+    let listener = TcpListener::bind("127.0.0.1:0").expect("bind positive-control listener");
+    let port = listener.local_addr().unwrap().port().to_string();
+    let mut control = Command::new(SYSTEM_NC);
+    control
+        .args(["-w", "2", "127.0.0.1", &port])
+        .stdin(Stdio::null())
+        .stdout(Stdio::null())
+        .stderr(Stdio::null());
+    assert!(control
+        .status()
+        .expect("unsandboxed nc positive control")
+        .success());
+    drop(
+        listener
+            .accept()
+            .expect("accept positive-control connection"),
+    );
+
+    let marker = root.join("allowed-write");
+    let denied_marker = outside.join("denied-write");
+    let script = format!(
+        "touch '{}' && if touch '{}'; then printf 'EXTERNAL_WRITE_ALLOWED'; else printf 'EXTERNAL_WRITE_DENIED'; fi; if cat '{}' 2>/dev/null; then printf 'SECRET_VISIBLE'; else printf 'SECRET_ABSENT'; fi; if {SYSTEM_NC} -w 2 127.0.0.1 {port} </dev/null; then printf 'NETWORK_CONNECTED'; else printf 'NETWORK_DENIED'; fi",
+        marker.display(),
+        denied_marker.display(),
+        secret.display()
+    );
+    let request = SpawnSpec::new(
+        "/bin/sh",
+        &root,
+        SandboxPlan::Confined {
+            writable_roots: vec![root.clone()],
+            readable_roots: Vec::new(),
+            network: NetworkPolicy::Deny,
+        },
+    )
+    .args(["-c", script.as_str()])
+    .stdout(StreamPolicy::Piped)
+    .stderr(StreamPolicy::Piped);
+    let mut owner = live_tree_owner();
+    let mut payload = ExecutionBroker::new()
+        .spawn_in_supervised_unix_tree(&request, &[], &mut owner)
+        .expect("spawn confined probe");
+    let stdout = payload.stdout.take().expect("piped stdout");
+    let stderr = payload.stderr.take().expect("piped stderr");
+    let out_reader = std::thread::spawn(move || {
+        let mut bytes = Vec::new();
+        stdout.take(4096).read_to_end(&mut bytes).map(|_| bytes)
+    });
+    let err_reader = std::thread::spawn(move || {
+        let mut bytes = Vec::new();
+        stderr.take(4096).read_to_end(&mut bytes).map(|_| bytes)
+    });
+    let deadline = std::time::Instant::now() + std::time::Duration::from_secs(8);
+    let status = loop {
+        if let Some(status) = payload.try_wait().expect("poll probe") {
+            break status;
+        }
+        if std::time::Instant::now() >= deadline {
+            owner
+                .terminate_tree()
+                .expect("terminate timed out probe group");
+            panic!("native probe exceeded 8 second deadline");
+        }
+        std::thread::sleep(std::time::Duration::from_millis(10));
+    };
+    let out = out_reader
+        .join()
+        .expect("stdout reader thread")
+        .expect("read probe stdout");
+    let err = err_reader
+        .join()
+        .expect("stderr reader thread")
+        .expect("read probe stderr");
+    assert!(
+        status.success(),
+        "probe failed: {:?}",
+        String::from_utf8_lossy(&err)
+    );
+    let output = String::from_utf8_lossy(&out);
+    assert!(
+        marker.exists(),
+        "allowed root write must succeed: {output:?}"
+    );
+    assert!(
+        !denied_marker.exists(),
+        "external write must be denied: {output:?}"
+    );
+    assert!(output.contains("EXTERNAL_WRITE_DENIED"), "{output:?}");
+    assert!(
+        output.contains("SECRET_ABSENT"),
+        "parent secret leaked: {output:?}"
+    );
+    assert!(
+        !output.contains("PARENT_SECRET_7db1"),
+        "parent secret leaked: {output:?}"
+    );
+    assert!(
+        output.contains("NETWORK_DENIED"),
+        "network was not denied: {output:?}"
+    );
+    owner.terminate_tree().expect("terminate owner group");
+    assert!(owner
+        .wait_tree_exit(std::time::Duration::from_secs(2))
+        .unwrap());
+}
